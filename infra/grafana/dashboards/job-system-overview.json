{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "System Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none", "lineWidth": 1 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(job_submissions_total[1m])",
          "legendFormat": "Submissions ({{task_type}}, {{priority}})",
          "refId": "A"
        },
        {
          "expr": "rate(job_executions_total[1m])",
          "legendFormat": "Executions ({{task_type}}, {{outcome}})",
          "refId": "B"
        }
      ],
      "title": "Job Throughput (Jobs / Sec)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 60, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "redis_queue_depth",
          "legendFormat": "Queue Lane: {{priority}}",
          "refId": "A"
        }
      ],
      "title": "Redis Priority Queue Depths",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Execution Latency & Workers",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(job_execution_duration_seconds_bucket[5m])) by (le, task_type))",
          "legendFormat": "p50 ({{task_type}})",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(job_execution_duration_seconds_bucket[5m])) by (le, task_type))",
          "legendFormat": "p95 ({{task_type}})",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(job_execution_duration_seconds_bucket[5m])) by (le, task_type))",
          "legendFormat": "p99 ({{task_type}})",
          "refId": "C"
        }
      ],
      "title": "Execution Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "active_workers_total",
          "legendFormat": "Workers",
          "refId": "A"
        }
      ],
      "title": "Active Worker Nodes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(outbox_published_events_total[1m])",
          "legendFormat": "Outbox Events/sec",
          "refId": "A"
        },
        {
          "expr": "rate(lease_reaper_reaped_jobs_total[1m])",
          "legendFormat": "Reaped Jobs/sec ({{action}})",
          "refId": "B"
        }
      ],
      "title": "Outbox & Lease Reaper Activity",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["distributed-systems", "task-queue", "observability"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Distributed Background Job System Overview",
  "uid": "job-system-overview",
  "version": 1
}
