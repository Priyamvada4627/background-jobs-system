# ==============================================================================
# Background Job Management System — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Background Job System"
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_system
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/job_system

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Worker Settings
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_LEASE_TTL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# Outbox Publisher Settings
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100

# Scheduler Settings
SCHEDULER_POLL_INTERVAL_SECONDS=1.0

# Reaper Settings
REAPER_POLL_INTERVAL_SECONDS=10.0

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
